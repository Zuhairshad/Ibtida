{
  "expo": {
    "name": "ibtida-app",
    "slug": "ibtida-app",
    "version": "1.0.0",
    "scheme": "ibtida",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSupportsTimeSensitiveNotifications": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Ibtida uses your camera to scan the QR tag on your prayer mat, confirming you're awake for the wake-verification alarm.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ibtida uses your location to calculate accurate prayer times and Qibla direction."
        }
      ],
      "expo-notifications",
      "./plugins/withIbadahAndroidManifest"
    ]
  }
}
